# Account definitions — TEMPLATE for new users.
#
# DO NOT EDIT THIS FILE DIRECTLY.
#   Run `uv run firm init` once and it will:
#     - ask how much capital you have in each account
#     - ask whether you have margin enabled
#     - optionally accept a paste of your current positions
#     - write the personalised config/accounts.yaml for you
#
# Keep this .example file as the canonical template.
# All currency in USD.

accounts:
  # Most retail traders have a brokerage cash account. Keep this entry.
  cash:
    display_name: "Cash Account"
    broker: "manual"              # No broker API; sync trades via Claude Code
    capital: 5000.00              # Replaced by `firm init` — this is the template default
    margin_enabled: false         # Set true if your broker enabled margin
    margin_multiplier: 2.0        # 2x is the standard reg-T overnight multiplier
    options_level: 3              # Long options + covered calls + CSPs
    allowed_actions:
      - buy_shares
      - sell_shares
      - sell_csp                  # Cash-secured put
      - sell_cc                   # Covered call
      - close_csp
      - close_cc
      - roll_csp
      - roll_cc
      - buy_put                   # Long put — hedge
      - buy_call                  # Long call — directional bet
      - sell_long_put
      - sell_long_call
    max_position_pct: 30
    notes: |
      Standard cash brokerage. With margin off, max share price for a 100-lot
      is capital/100. With 2x margin on, double that.

  # Optional. Delete this block if you don't have a Roth IRA.
  roth_ira:
    display_name: "Roth IRA"
    broker: "manual"
    capital: 20000.00             # Replaced by `firm init`
    margin_enabled: false         # IRS rule: no margin in IRAs (do not edit)
    margin_multiplier: 1.0
    options_level: 2              # CSP + CC only; no naked, no spreads
    allowed_actions:
      - buy_shares
      - sell_shares
      - sell_csp
      - sell_cc
      - close_csp
      - close_cc
      - roll_csp
      - roll_cc
    max_position_pct: 25
    notes: |
      Tax-advantaged. No margin (IRS). Wheel-only — CSP + CC.
