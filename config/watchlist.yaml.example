# Watchlist — TEMPLATE for new users.
#
# DO NOT EDIT THIS FILE DIRECTLY.
#   `uv run firm init` will ask you for the tickers you want to follow and
#   write a personalised config/watchlist.yaml.
#
# Fields:
#   - sector: groups for the Scout when finding similar names
#   - max_position_pct: optional per-ticker override of the account default
#   - target_csp_strike: optional manual hint ("I'd be happy buying at $X")
#   - target_cc_strike: optional minimum strike for covered calls (defaults to cost basis)
#   - notes: free-form, surfaced to Claude Code as context
#
# Below is a starter watchlist of liquid, options-friendly names that work
# well for the wheel. `firm init` will replace it with your selections.

watchlist:
  # ── Broad-market ETFs (great for first-time wheel traders) ──
  - symbol: SPY
    sector: broad_etf
    notes: "S&P 500 ETF. Deep options, tight spreads. Roth-only at current prices."
  - symbol: QQQ
    sector: broad_etf
    notes: "Nasdaq-100 ETF. Tech-heavy. Roth-only at current prices."

  # ── Liquid mega-caps with good options ──
  - symbol: AAPL
    sector: large_cap_tech
    notes: "Liquid options, predictable. Roth-only at current prices."
  - symbol: MSFT
    sector: large_cap_tech
    notes: "Liquid options. Roth-only."
  - symbol: AMD
    sector: semis_gpu
    notes: "Volatile, rich IV around catalysts."
  - symbol: NVDA
    sector: semis_gpu
    notes: "Liquid but Roth-only at current prices."

  # ── Affordable wheel candidates (cash account friendly) ──
  - symbol: F
    sector: autos
    notes: "Single-digit-price candidate. Pays a dividend. Cash-account-sized."
  - symbol: INTC
    sector: semis_gpu
    notes: "Turnaround story. Affordable; works in a small cash account."

# Sectors the Scout should look in for similar opportunities
scout_sectors:
  - large_cap_tech
  - semis_gpu
  - broad_etf
  - autos

# Hard filter for Scout when searching new candidates
scout_filters:
  min_avg_volume: 500000             # Need liquidity
  min_options_open_interest: 100     # Need tradable options
  max_share_price_roth: 200          # Tune to your Roth IRA capital / 100
  max_share_price_cash: 50           # Tune to your cash account capital / 100
  min_iv_rank: 30                    # Only flag names with rich premium
